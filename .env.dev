# Development Environment Configuration
# Usage: Set this file as active in your IDE or use: export $(cat .env.dev | xargs)

# OAuth Configuration
OAUTH_ISSUER=http://localhost:8080/realms/fastapi-openai-rag
OAUTH_AUDIENCE=fastapi-client

# JWT Configuration
JWT_SECRET=fastapi-secret-key-dev
JWT_ALGORITHM=HS256

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=fastapi-openai-rag

# Observability
OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=fastapi-openai-rag-dev
OTEL_SERVICE_VERSION=1.0.0-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACING_ENABLED=true
OTEL_SAMPLING_RATE=1.0
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4317
OTEL_LOGGING_ENABLED=true
OTEL_LOG_LEVEL=DEBUG

# OpenTelemetry configuration
ENABLE_OTLP_LOGS=true
OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_SERVICE_NAME=fastapi-openai-rag

# Database
DATABASE_URL=sqlite:///./fastapi_dev.db

# App
DEBUG_MODE=true
RELOAD_ON_CHANGES=true
LOG_LEVEL=DEBUG

# Metrics Configuration
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4317

# Logging Configuration
OTEL_LOGGING_ENABLED=true
OTEL_LOG_LEVEL=DEBUG
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true


# Development Database Configuration
DATABASE_URL=sqlite:///./fastapi_dev.db

# Development Mode Flags
DEBUG_MODE=true
RELOAD_ON_CHANGES=true
LOG_LEVEL=DEBUG
